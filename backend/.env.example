# ---------------------------------------------------------------------------
# Backend configuration. Copy to backend/.env and fill in, or export these in
# your shell / hosting provider's dashboard. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local Postgres via docker compose:
DATABASE_URL=jdbc:postgresql://localhost:5432/future_designer
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# Neon example (note sslmode=require):
# DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=...

# --- AI provider (required for POST /analyze) ------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192
# GEMINI_STRUCTURED_OUTPUT=true
# Set to 0 to switch off model "thinking" for a faster demo; -1 keeps the model default.
# GEMINI_THINKING_BUDGET=-1

# --- Web -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# PORT=8080

# --- Pipeline tuning -------------------------------------------------------
# ANALYSIS_SNIPPET_COUNT=4
# ANALYSIS_RATE_LIMIT_ENABLED=true
# ANALYSIS_RATE_LIMIT_PER_MINUTE=20
# LOG_LEVEL=INFO
