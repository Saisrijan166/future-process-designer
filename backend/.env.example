# =============================================================================
# BACKEND ENVIRONMENT — TEMPLATE. Copy to backend/.env and fill in GEMINI_API_KEY.
#
# Spring Boot does NOT read this file by itself. Load it one of two ways:
#
#   ./run-local.sh                       <- reads this file and starts the app
#   set -a; source .env; set +a; ./mvnw spring-boot:run
#
# Layout: LOCAL values are active. PRODUCTION values are commented out at the
# bottom of each section — uncomment there and comment the local line to switch,
# or (better) set them in the Render dashboard and never edit this file for prod.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE  (required)
# -----------------------------------------------------------------------------
# LOCAL — the userspace PostgreSQL started by ../scripts/local-db.sh
# Start it first:  ./scripts/local-db.sh start
DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/future_designer
DATABASE_USERNAME=devuser
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5

# LOCAL alternative — if you use `docker compose up -d` instead:
# DATABASE_URL=jdbc:postgresql://localhost:5432/future_designer
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres

# PRODUCTION — Neon. Keep sslmode=require, and use the POOLER host (the one with
# "-pooler" in it) so the free tier's connection limit is not exhausted.
# DATABASE_URL=jdbc:postgresql://ep-xxxxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=<neon-password>
# DATABASE_POOL_SIZE=3


# -----------------------------------------------------------------------------
# AI PROVIDERS  (at least one key required for POST /api/processes/{id}/analyze)
#
# The app tries the primary first and falls back down the chain when a provider
# fails — most often because a free-tier quota ran out mid-demo. Whichever one
# actually answers is recorded on the run, along with why the earlier one was
# passed over, so a fallback is visible rather than silent.
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq

# --- Primary: Google Gemini ---------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-3.1-flash-lite: verified working on 14-08-2026 and far kinder to the free
# tier than the full Flash models, whose daily request allowance is tiny (the
# previous default, gemini-3.7-flash, exhausted at 20 requests/day).
# Note: gemini-2.5-flash is still listed by the models endpoint but is rejected for
# new keys ("no longer available to new users") — pin a model you have actually
# called. For higher quality at higher quota cost, try gemini-3.7-flash.
GEMINI_MODEL=gemini-3.1-flash-lite

# Lower = more deterministic. 0.2 keeps output specific without being repetitive.
GEMINI_TEMPERATURE=0.2

# Ceiling on response length. Raise if the run trace shows finishReason MAX_TOKENS.
GEMINI_MAX_OUTPUT_TOKENS=8192

# Ask Gemini to enforce the JSON schema server-side. Local validation and the
# repair retry still run either way — this only reduces how often they fire.
GEMINI_STRUCTURED_OUTPUT=true

# 0 disables model "thinking". Worth keeping at 0: thinking tokens are charged
# against the same free-tier output allowance, and this task does not need them.
# -1 restores the model's own default.
GEMINI_THINKING_BUDGET=0

# --- Fallback: Groq -----------------------------------------------------------
# Free key from https://console.groq.com/keys. Groq's free daily allowance is much
# larger than Gemini's, which is exactly what makes it a useful safety net.
GROQ_API_KEY=

# llama-3.3-70b-versatile is the fallback default because it *completes*: it fits
# inside Groq's free tokens-per-minute budget and does not truncate. Its analysis
# is noticeably terser than Gemini's — acceptable, since the fallback's job is to
# keep the demo alive, not to be the best writer in the room.
#   openai/gpt-oss-120b   richer output, but only ~8k tokens/minute on the free
#                         tier, so it truncates at 4096 and rate-limits on a retry
#   openai/gpt-oss-20b    faster, middling quality
#   llama-3.1-8b-instant  fastest, weakest
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2

# Lower than Gemini's on purpose: Groq reserves the requested maximum against the
# per-minute budget, so 8192 gets the larger models rejected with a 413.
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_STRUCTURED_OUTPUT=true

# PRODUCTION — set both keys in the Render dashboard, never in a file.
# To disable failover entirely, set AI_FALLBACK_PROVIDERS to an empty value.


# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Signing key for session tokens (HS256), minimum 32 characters. Anyone holding
# this can mint a token for any account, so treat it like a password.
#   openssl rand -base64 48
AUTH_JWT_SECRET=

# How long a sign-in lasts before the user has to sign in again.
AUTH_TOKEN_TTL_HOURS=12

# Creates a known account on first start so the app can be opened without
# registering. Convenient for a demo, a liability anywhere else.
AUTH_DEMO_ACCOUNT_ENABLED=true
AUTH_DEMO_EMAIL=demo@assesswise.test
AUTH_DEMO_PASSWORD=demo12345
AUTH_DEMO_DISPLAY_NAME=Demo User

# PRODUCTION — set a real AUTH_JWT_SECRET in the Render dashboard and turn the
# demo account off:
# AUTH_DEMO_ACCOUNT_ENABLED=false

# -----------------------------------------------------------------------------
# WEB
# -----------------------------------------------------------------------------
# Origins allowed to call the API. Comma-separated, no trailing slash.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PRODUCTION — the deployed frontend. Include the Vercel preview domain too if
# you want preview deployments to work against the live API.
# APP_CORS_ALLOWED_ORIGINS=https://ai-future-process-designer.vercel.app

# Port the backend listens on. Render injects its own PORT; leave this unset there.
PORT=8080


# -----------------------------------------------------------------------------
# PIPELINE TUNING  (all optional — these are the defaults)
# -----------------------------------------------------------------------------
# How many curated research snippets are injected into each prompt.
ANALYSIS_SNIPPET_COUNT=4

# Guards the free AI quota against a double-clicked button or a runaway script.
ANALYSIS_RATE_LIMIT_ENABLED=true
ANALYSIS_RATE_LIMIT_PER_MINUTE=20


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# DEBUG additionally logs retrieval scores and prompt sizes.
LOG_LEVEL=INFO

# PRODUCTION
# LOG_LEVEL=INFO
