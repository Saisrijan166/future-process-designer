# =============================================================================
# FRONTEND ENVIRONMENT — TEMPLATE. Copy to frontend/.env.local.
#
# Next.js reads this file automatically on `npm run dev` and `npm run build`.
# No script needed, unlike the backend.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time and
# are visible to anyone who loads the page. Never put a secret here — this app
# has none on the frontend, because every AI call happens on the backend.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND API  (required)
# -----------------------------------------------------------------------------
# Base URL of the Spring Boot service. No trailing slash.
#
# LOCAL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# PRODUCTION — the Render service URL. Because this is inlined at build time,
# changing it in Vercel requires a REDEPLOY, not just a restart.
# NEXT_PUBLIC_API_BASE_URL=https://ai-future-process-designer-api.onrender.com
